# LLM proposer config for the LawResearch machine (machine/llm.py). Copy to machine/.env
# (gitignored) and fill in ONE provider block. The machine calls the model at exactly one
# state (proposing); if this is unset, the loop runs on lagh alone.
#
# Same LLM_* contract as deploy/hermes/.env:
#   LLM_API_MODE = anthropic_messages   for an /anthropic (Anthropic Messages) endpoint
#              = (leave EMPTY)         for the OpenAI Chat dialect (xAI/Grok, OpenAI)

# ---- pick ONE provider block ----

# Grok 4.5 (xAI, OpenAI-compatible)
LLM_MODEL=grok-4.5
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_MODE=
LLM_API_KEY=put-your-xai-key-here

# GPT-5.6 (OpenAI) -- uncomment, clear the Grok block
# LLM_MODEL=gpt-5.6
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_MODE=
# LLM_API_KEY=put-your-openai-key-here

# MiniMax M3 (Anthropic-compatible endpoint) -- uncomment, clear the Grok block
# LLM_MODEL=MiniMax-M3
# LLM_BASE_URL=https://api.minimax.io/anthropic
# LLM_API_MODE=anthropic_messages
# LLM_API_KEY=put-your-minimax-key-here
