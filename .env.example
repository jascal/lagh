# LLM provider for the lagh "scientist" harness (the LLM that orchestrates the
# recover/verify/fit tools). Copy this file to `.env` and fill it in.
#   cp .env.example .env   &&   $EDITOR .env
# `.env` is gitignored -- never commit your key. The config is OpenAI-compatible
# (base_url + key + model), so the same three vars point at MiniMax, Hermes, or any
# OpenAI-compatible endpoint; switching provider is just editing these.

# --- primary: MiniMax M3 ---
LLM_PROVIDER=minimax
LLM_BASE_URL=https://api.minimax.io/v1     # adjust to your region if needed (e.g. api.minimaxi.com)
LLM_API_KEY=put-your-minimax-key-here
LLM_MODEL=MiniMax-M3                        # the exact model string from your MiniMax console
# LLM_GROUP_ID=                             # only if your MiniMax endpoint requires a GroupId

# --- alternative: Nous Hermes (uncomment + point at your serving endpoint) ---
# LLM_PROVIDER=hermes
# LLM_BASE_URL=https://openrouter.ai/api/v1  # or Together/your own vLLM, whatever serves Hermes
# LLM_API_KEY=put-your-key-here
# LLM_MODEL=nousresearch/hermes-4-405b       # the provider's exact model id

# --- alternative: a MiniMax Agent / MCP-native host serves lagh directly ---
# If your MiniMax Agent (or any host) speaks MCP, it can consume lagh's .mcp.json
# directly and NO harness/LLM key is needed here -- the host does the orchestration.
