# Backing model + benchmark config for the Hermes container. Copy to .env (gitignored)
# and fill in. Model-AGNOSTIC: the SAME harness runs on any provider -- swap models by
# editing these vars and `docker compose up -d` (recreates + regenerates the config).
#
# LLM_API_MODE = anthropic_messages   for an /anthropic (Anthropic Messages) endpoint
#              = (leave EMPTY)         for the OpenAI Chat dialect (xAI/Grok, OpenAI)

# ---- pick ONE provider block ----

# MiniMax M3 (Anthropic-compatible endpoint)
LLM_MODEL=MiniMax-M3
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_API_MODE=anthropic_messages
LLM_API_KEY=put-your-key-here

# Grok 4.5 (xAI, OpenAI-compatible) -- uncomment, and clear LLM_API_MODE above
# LLM_MODEL=grok-4.5
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_MODE=
# LLM_API_KEY=put-your-xai-key-here

# GPT-5 / GPT-6 (OpenAI) -- uncomment, and clear LLM_API_MODE above
# LLM_MODEL=gpt-6
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_MODE=
# LLM_API_KEY=put-your-openai-key-here

# ---- benchmark ----
LAB_SOURCE=newtonbench          # proxy (self-contained) | newtonbench (real dev cells)
