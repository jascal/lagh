# MiniMax credentials for the Hermes container. Copy to .env (gitignored) and fill in.
#   cp .env.example .env  &&  $EDITOR .env
# Hermes reads the KEY from the container env (config.yaml uses key_env: LLM_API_KEY),
# so the secret never lands in a config file.

LLM_MODEL=MiniMax-M3                      # exact model id from your MiniMax console
LLM_BASE_URL=https://api.minimax.io/anthropic   # MiniMax's Anthropic-compatible endpoint (Messages API)
LLM_API_KEY=put-your-minimax-key-here
